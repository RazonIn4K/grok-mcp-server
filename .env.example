# xAI API Configuration
# Get your API key from https://console.x.ai
XAI_API_KEY=xai-your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1

# Grok Model Configuration
# Current general-purpose text model. Override per tool call when needed.
GROK_MODEL=grok-4.7
# Current flagship supports Responses API web/X search tools.
GROK_SEARCH_MODEL=grok-4.7
GROK_TEMPERATURE=0.7
GROK_MAX_TOKENS=4000

# Optional: Timeout / retry configuration
# Keep the overall search deadline below the MCP client's tool timeout.
GROK_TIMEOUT_MS=45000
GROK_ASK_OVERALL_TIMEOUT_MS=90000
GROK_SEARCH_TIMEOUT_MS=45000
GROK_SEARCH_OVERALL_TIMEOUT_MS=90000
GROK_RETRIES=1
GROK_SEARCH_RETRIES=0
GROK_RETRY_DELAY_MS=1000

# Optional: Rate-limit tuning (defaults are conservative)
GROK_MAX_CONCURRENT=2
GROK_MIN_TIME_MS=500

# MCP Server Configuration
MCP_SERVER_NAME=grok-4-mcp-server
MCP_SERVER_VERSION=2.3.0
SHARED_SECRET=your_shared_secret_here

# Logging Configuration
LOG_LEVEL=info
NODE_ENV=production
