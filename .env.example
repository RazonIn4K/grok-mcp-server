# xAI API Configuration for Grok 4.5
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1

# Optional: Grok model configuration
GROK_MODEL=grok-4.5
GROK_TEMPERATURE=0.7
GROK_MAX_TOKENS=4000

# Optional: Timeout / retry configuration
# Increase these if you see timeout errors from long reasoning or search requests.
GROK_TIMEOUT_MS=60000
GROK_SEARCH_TIMEOUT_MS=120000
GROK_RETRIES=2
GROK_RETRY_DELAY_MS=1000

# Optional: Rate-limit tuning (defaults are conservative)
GROK_MAX_CONCURRENT=2
GROK_MIN_TIME_MS=500

# MCP Server Configuration
MCP_SERVER_NAME=grok-4-mcp-server
MCP_SERVER_VERSION=1.0.0
SHARED_SECRET=your_shared_secret_here
