{
  "name": "grok-mcp-server",
  "version": "2.3.0",
  "description": "MCP Server for xAI Grok AI Model Integration",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "test": "vitest run src/",
    "test:watch": "vitest src/",
    "coverage": "vitest run src/ --coverage"
  },
  "keywords": [
    "mcp",
    "grok",
    "xai",
    "ai",
    "server"
  ],
  "author": "David Ortiz",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "agentkeepalive": "4.6.0",
    "axios": "1.20.0",
    "bottleneck": "2.19.5",
    "dotenv": "17.4.2",
    "lru-cache": "11.5.3",
    "pino": "9.14.0",
    "prom-client": "15.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "4.1.11",
    "c8": "10.1.3",
    "fast-check": "3.23.2",
    "pino-pretty": "13.1.3",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
